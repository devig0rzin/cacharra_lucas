# Copie para .env.local e preencha. Sem nada preenchido, o site roda em modo
# desenvolvimento: banco embutido (PGlite em .data/), pagamento simulado e
# e-mails impressos no terminal.

# URL pública do site (sem barra no final)
SITE_URL=http://localhost:3000

# ── Banco (Supabase) ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (porta 6543)
# Em branco = PGlite local (só desenvolvimento).
DATABASE_URL=

# ── Pagamento ────────────────────────────────────────────────────
# mock = tela de pagamento simulado | mercadopago = Checkout Pro de verdade
PAYMENTS_PROVIDER=mock
# Mercado Pago → Suas integrações → Credenciais (use as de TESTE primeiro)
MP_ACCESS_TOKEN=
# Mercado Pago → Suas integrações → Webhooks → "Assinatura secreta"
MP_WEBHOOK_SECRET=

# ── E-mail (Resend) ──────────────────────────────────────────────
# Em branco = e-mails só aparecem no terminal.
RESEND_API_KEY=
EMAIL_FROM="Chácara Serra Verde <reservas@seudominio.com.br>"
OWNER_EMAIL=proprietario@seudominio.com.br

# ── Airbnb ───────────────────────────────────────────────────────
# Anúncio → Calendário → Disponibilidade → Sincronizar calendários → Exportar calendário
AIRBNB_ICAL_URL=
# Segredo que vai no link que o Airbnb importa: {SITE_URL}/api/calendario/{ICAL_EXPORT_TOKEN}.ics
# Gere com: openssl rand -hex 24
ICAL_EXPORT_TOKEN=

# ── Agendador e painel ───────────────────────────────────────────
# Gere com: openssl rand -hex 24
CRON_SECRET=
ADMIN_PASSWORD=
# Gere com: openssl rand -hex 32
ADMIN_SESSION_SECRET=
